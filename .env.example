NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27018/localcart?replicaSet=localcart-rs
JWT_SECRET=replace-with-at-least-32-random-characters
# Keep stable for outstanding pickup orders. Blank falls back to JWT_SECRET.
PICKUP_ENCRYPTION_SECRET=
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
# Server only. Leave blank to use placeholders until image storage is configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TRUST_PROXY_HOPS=0
SERVE_CLIENT=false
# Optional override for npm run db:local. Otherwise the helper finds an installed mongod.
MONGOD_PATH=
